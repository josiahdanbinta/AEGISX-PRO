.classpath
.project
.settings/

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# Xcode
*.xcodeproj
*.xcworkspace
*.xcuserdata

# ── Operating System ─────────────────────────────────────────────
