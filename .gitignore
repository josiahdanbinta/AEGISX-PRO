node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ── Frontend Build ───────────────────────────────────────────────
frontend/dist/
frontend/build/

