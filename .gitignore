*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
eggs/
.eggs/
*.whl
.venv/
venv/
ENV/
env/
.env
.env.*
!.env.example
.python-version
*.manifest
*.spec

# ── Testing & Coverage ───────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

