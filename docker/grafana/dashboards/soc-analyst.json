{
  "title": "SOC Analyst Dashboard",
  "uid": "aegisx-soc-analyst",
  "tags": ["aegisx", "soc", "alerts"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "Open Alerts by Severity",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [
        {
          "expr": "sum(aegisx_alerts_open{severity=\"critical\"})",
          "legendFormat": "Critical",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": 0},
            {"color": "red", "value": 1}
          ]}
        }
      },
      "options": {"colorMode": "background", "graphMode": "area"}
    },
    {
      "id": 2,
      "title": "High Severity",
      "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=\"high\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": 0}, {"color": "orange", "value": 5}, {"color": "red", "value": 20}
      ]}}}
    },
    {
      "id": 3,
      "title": "Medium Severity",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=\"medium\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
        {"color": "blue", "value": 0}, {"color": "yellow", "value": 10}
      ]}}}
    },
    {
      "id": 4,
      "title": "Low / Info",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=~\"low|info\"})", "refId": "A"}]
    },
    {
      "id": 5,
      "title": "Today's Alert Trend",
      "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(aegisx_alerts_created_total[5m])) by (severity)",
          "legendFormat": "{{severity}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 20, "stacking": {"mode": "normal"}}}}
    },
    {
      "id": 6,
      "title": "Alert Timeline (last 6 hours)",
      "type": "state-timeline",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 6},
      "targets": [
        {
          "expr": "aegisx_alerts_open",
          "legendFormat": "Alerts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Top Alerting Rules",
      "type": "bargauge",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 7},
      "targets": [
        {
          "expr": "topk(10, sum(aegisx_alerts_created_total) by (rule_name))",
          "legendFormat": "{{rule_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Top Attacked Hosts",
      "type": "bargauge",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 7},
      "targets": [
        {
          "expr": "topk(10, sum(aegisx_events_by_hostname) by (hostname))",
          "legendFormat": "{{hostname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Detection Rules Performance",
      "type": "table",
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 8},
      "targets": [
        {
          "expr": "topk(20, sort_desc(avg by (rule_name, rule_id) (aegisx_detection_rule_executions_total)))",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        {"id": "organize", "options": {
          "excludeByName": {"Time": true},
          "renameByName": {
            "rule_name": "Rule Name",
            "rule_id": "Rule ID",
            "Value": "Executions"
          }
        }}
      ]
    },
    {
      "id": 10,
      "title": "My Assigned Alerts",
      "type": "table",
      "gridPos": {"x": 0, "y": 25, "w": 24, "h": 7},
      "targets": [
        {
          "expr": "sort_desc(aegisx_alerts_assigned_total)",
          "format": "table",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
