{
  "title": "AEGIS Per-Tenant Metrics",
  "uid": "AEGIS-tenant-metrics",
  "tags": ["AEGIS", "tenant", "analytics"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1, "title": "Event Volume by Tenant", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum by (tenant_id) (rate(AEGIS_events_ingested_total[5m]))", "legendFormat": "{{tenant_id}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 2, "title": "Alerts by Tenant (24h)", "type": "bargauge",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(AEGIS_alerts_created_total[24h]) by (tenant_id)", "legendFormat": "{{tenant_id}}", "refId": "A"}]
    },
    {
      "id": 3, "title": "Alert Severity Distribution", "type": "piechart",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "sum(AEGIS_alerts_open) by (severity)", "legendFormat": "{{severity}}", "refId": "A"}]
    },
    {
      "id": 4, "title": "Analyst Workload", "type": "bargauge",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "sum(AEGIS_alerts_assigned_total) by (user_id)", "legendFormat": "assigned", "refId": "A"}]
    },
    {
      "id": 5, "title": "Mean Resolution Time", "type": "gauge",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "avg(AEGIS_alert_resolution_time_seconds) / 3600", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "h", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 4}, {"color": "red", "value": 24}]}}}
    },
    {
      "id": 6, "title": "Storage Usage", "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "targets": [
        {"expr": "AEGIS_storage_bytes_used / 1073741824", "legendFormat": "Used GB", "refId": "A"},
        {"expr": "AEGIS_storage_bytes_quota / 1073741824", "legendFormat": "Quota GB", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "decgbytes"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1
}
