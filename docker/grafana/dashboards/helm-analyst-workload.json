{
  "title": "AEGISX Analyst Workload",
  "uid": "aegisx-analyst-workload",
  "tags": ["aegisx", "analyst", "soc"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1, "title": "Open Alerts by Severity", "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=\"critical\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2, "title": "High Severity", "type": "stat",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=\"high\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "orange", "value": 5}, {"color": "red", "value": 20}]}}}
    },
    {
      "id": 3, "title": "Medium Severity", "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=\"medium\"})", "refId": "A"}]
    },
    {
      "id": 4, "title": "Low / Info", "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 4, "h": 4},
      "targets": [{"expr": "sum(aegisx_alerts_open{severity=~\"low|info\"})", "refId": "A"}]
    },
    {
      "id": 5, "title": "Alert Trend (24h)", "type": "timeseries",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 4},
      "targets": [{"expr": "sum(rate(aegisx_alerts_created_total[10m])) by (severity)", "legendFormat": "{{severity}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"stacking": {"mode": "normal"}}}}
    },
    {
      "id": 6, "title": "Today's Alert Timeline", "type": "state-timeline",
      "gridPos": {"x": 0, "y": 4, "w": 24, "h": 6},
      "targets": [{"expr": "aegisx_alerts_open", "refId": "A"}]
    },
    {
      "id": 7, "title": "Top Alerting Rules", "type": "bargauge",
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 7},
      "targets": [{"expr": "topk(10, sum(aegisx_alerts_created_total) by (rule_name))", "legendFormat": "{{rule_name}}", "refId": "A"}]
    },
    {
      "id": 8, "title": "Top Attacked Hosts", "type": "bargauge",
      "gridPos": {"x": 12, "y": 10, "w": 12, "h": 7},
      "targets": [{"expr": "topk(10, sum(aegisx_events_by_hostname) by (hostname))", "legendFormat": "{{hostname}}", "refId": "A"}]
    },
    {
      "id": 9, "title": "Rule Execution Performance", "type": "table",
      "gridPos": {"x": 0, "y": 17, "w": 24, "h": 8},
      "targets": [{"expr": "topk(20, aegisx_detection_rule_executions_total)", "format": "table", "refId": "A"}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
