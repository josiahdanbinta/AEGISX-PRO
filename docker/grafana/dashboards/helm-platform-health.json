{
  "title": "AEGIS Platform Health",
  "uid": "AEGIS-platform-health",
  "tags": ["AEGIS", "platform", "operations"],
  "timezone": "browser",
  "editable": true,
  "panels": [
    {
      "id": 1, "title": "Event Ingestion Rate", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "sum(rate(AEGIS_events_ingested_total[5m]))", "legendFormat": "events/sec", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}}
    },
    {
      "id": 2, "title": "API Response Time (P95 by endpoint)", "type": "timeseries",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "targets": [{"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m])) by (handler)", "legendFormat": "{{handler}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 3, "title": "API Request Rate by Status", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "targets": [
        {"expr": "rate(http_requests_total{status=~\"2..\"}[5m])", "legendFormat": "2xx", "refId": "A"},
        {"expr": "rate(http_requests_total{status=~\"4..\"}[5m])", "legendFormat": "4xx", "refId": "B"},
        {"expr": "rate(http_requests_total{status=~\"5..\"}[5m])", "legendFormat": "5xx", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"fillOpacity": 15, "stacking": {"mode": "normal"}}}}
    },
    {
      "id": 4, "title": "Alert Generation Latency", "type": "timeseries",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(AEGIS_alert_generation_duration_seconds_bucket[5m]))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, rate(AEGIS_alert_generation_duration_seconds_bucket[5m]))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, rate(AEGIS_alert_generation_duration_seconds_bucket[5m]))", "legendFormat": "P99", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 5, "title": "Service Uptime", "type": "stat",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "targets": [{"expr": "avg(up) * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 95}, {"color": "green", "value": 99}]}}}
    },
    {
      "id": 6, "title": "Stream Processor Throughput", "type": "timeseries",
      "gridPos": {"x": 0, "y": 16, "w": 8, "h": 7},
      "targets": [
        {"expr": "rate(AEGIS_stream_events_processed_total[5m])", "legendFormat": "processed/sec", "refId": "A"},
        {"expr": "rate(AEGIS_stream_duplicates_total[5m])", "legendFormat": "dupes/sec", "refId": "B"},
        {"expr": "rate(AEGIS_stream_alerts_generated_total[5m])", "legendFormat": "alerts/sec", "refId": "C"}
      ]
    },
    {
      "id": 7, "title": "Database Connections", "type": "gauge",
      "gridPos": {"x": 8, "y": 16, "w": 8, "h": 7},
      "targets": [{"expr": "AEGIS_db_connections_active / AEGIS_db_connections_max * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 60}, {"color": "red", "value": 85}]}}}
    },
    {
      "id": 8, "title": "Detection Rule Stats (Top 10)", "type": "bargauge",
      "gridPos": {"x": 16, "y": 16, "w": 8, "h": 7},
      "targets": [{"expr": "topk(10, sum(rate(AEGIS_detection_rule_executions_total[5m])) by (rule_name))", "legendFormat": "{{rule_name}}", "refId": "A"}]
    },
    {
      "id": 9, "title": "UEBA Anomaly Score Distribution", "type": "heatmap",
      "gridPos": {"x": 0, "y": 23, "w": 12, "h": 7},
      "targets": [{"expr": "sum(rate(AEGIS_ueba_score_bucket[5m])) by (le)", "legendFormat": "score <= {{le}}", "refId": "A"}]
    },
    {
      "id": 10, "title": "Active Alerts by Severity", "type": "bargauge",
      "gridPos": {"x": 12, "y": 23, "w": 12, "h": 7},
      "targets": [{"expr": "sum(AEGIS_alerts_open) by (severity)", "legendFormat": "{{severity}}", "refId": "A"}]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "version": 1
}
