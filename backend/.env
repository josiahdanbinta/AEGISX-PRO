# ================================================================
# AEGISX Platform - Environment Configuration
# ================================================================

# ── Application ──────────────────────────────────────────────────
APP_NAME=AEGISX
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-in-production-use-secrets-manager-64-chars-min
API_V1_PREFIX=/api/v1
PROJECT_NAME=AEGISX Platform

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# ── CORS ─────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost","http://localhost:80"]

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegisx
POSTGRES_PASSWORD=aegisx
POSTGRES_DB=aegisx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# DATABASE_URL is auto-assembled from above, override here if needed:
# DATABASE_URL=postgresql+asyncpg://aegisx:aegisx@localhost:5432/aegisx
# SQLALCHEMY_DATABASE_URL=postgresql://aegisx:aegisx@localhost:5432/aegisx

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Celery ───────────────────────────────────────────────────────
# CELERY_BROKER_URL defaults to REDIS_URL, override if using RabbitMQ:
# CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
# CELERY_RESULT_BACKEND defaults to REDIS_URL

# ── OpenSearch / Elasticsearch ───────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX_PREFIX=aegisx

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-use-strong-random-64-chars-min
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_HOURS=24

# ── Password Policy ──────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_LOCKOUT_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15

# ── MFA ──────────────────────────────────────────────────────────
MFA_ENABLED=true
MFA_ISSUER=AEGISX

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=1000/minute

# ── File Upload ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=["csv","json","xml","pdf","xlsx","docx","txt","log","pcap","zip","tar","gz"]
UPLOAD_DIR=/app/uploads

# ── Email ────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aegisx.com
SMTP_TLS=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# ── Tenants ──────────────────────────────────────────────────────
MAX_TENANTS=10000
TENANT_ISOLATION_MODE=row
DEFAULT_TENANT_QUOTA_ASSETS=1000
DEFAULT_TENANT_QUOTA_USERS=100
DEFAULT_TENANT_QUOTA_STORAGE_GB=500

# ── AI / ML ──────────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
OPENAI_API_KEY=
OPENAI_API_BASE=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Threat Intelligence ──────────────────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
MISP_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_API_KEY=

# ── Agent Registration ───────────────────────────────────────────
AGENT_REGISTRATION_KEY=change-me-agent-key
AGENT_HEARTBEAT_INTERVAL=60
AGENT_STALE_TIMEOUT=300

# ── Kubernetes ───────────────────────────────────────────────────
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=aegisx

# ── Feature Flags ────────────────────────────────────────────────
FEATURE_SOAR=true
FEATURE_THREAT_INTEL=true
FEATURE_AI=true
FEATURE_COMPLIANCE=true
FEATURE_VULNERABILITY=true
FEATURE_ASSET_DISCOVERY=true
FEATURE_AGENT=true
FEATURE_AUDIT=true
FEATURE_GRAPHQL=true
