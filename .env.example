# ================================================================
# AEGISX Platform - Environment Configuration (Example)
# ================================================================
# Copy this file to backend/.env and modify values for your deployment.
# Never commit real secrets to version control.

# ── Application ──────────────────────────────────────────────────
APP_NAME=AEGISX
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-at-least-64-chars
API_V1_PREFIX=/api/v1
PROJECT_NAME=AEGISX Platform

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# ── CORS ─────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost

# ── PostgreSQL ───────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegisx
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=aegisx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Celery ───────────────────────────────────────────────────────
# Optional: override broker/backend if not using Redis
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── OpenSearch ───────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX_PREFIX=aegisx

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_HOURS=24

# ── Password Policy ──────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_LOCKOUT_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15

# ── MFA ──────────────────────────────────────────────────────────
MFA_ENABLED=true
MFA_ISSUER=AEGISX

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=1000/minute

# ── File Upload ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xml,pdf,xlsx,docx,txt,log,pcap,zip,tar,gz
UPLOAD_DIR=/app/uploads

# ── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aegisx.com
SMTP_TLS=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# ── Tenants ──────────────────────────────────────────────────────
MAX_TENANTS=10000
TENANT_ISOLATION_MODE=row
DEFAULT_TENANT_QUOTA_ASSETS=1000
DEFAULT_TENANT_QUOTA_USERS=100
DEFAULT_TENANT_QUOTA_STORAGE_GB=500

# ── AI / ML (Optional) ───────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
OPENAI_API_KEY=
OPENAI_API_BASE=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Threat Intelligence (Optional) ───────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
MISP_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_API_KEY=

# ── Agent Registration ───────────────────────────────────────────
AGENT_REGISTRATION_KEY=change-me-agent-key
AGENT_HEARTBEAT_INTERVAL=60
AGENT_STALE_TIMEOUT=300

# ── Kubernetes ───────────────────────────────────────────────────
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=aegisx

# ── Feature Flags ────────────────────────────────────────────────
FEATURE_SOAR=true
FEATURE_THREAT_INTEL=true
FEATURE_AI=true
FEATURE_COMPLIANCE=true
FEATURE_VULNERABILITY=true
FEATURE_ASSET_DISCOVERY=true
FEATURE_AGENT=true
FEATURE_AUDIT=true
FEATURE_GRAPHQL=true
