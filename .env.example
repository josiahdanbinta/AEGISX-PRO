# ================================================================  
# AEGISX Platform - Environment Configuration (Example)
# ================================================================  
# Copy this file to backend/.env and modify values for your deployment.
# Never commit real secrets to version control.

# ── Application ──────────────────────────────────────────────────
APP_NAME=AEGISX
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
SECRET_KEY=generate-a-strong-random-secret-key-at-least-64-chars
API_V1_PREFIX=/api/v1
PROJECT_NAME=AEGISX Platform

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
WORKERS=4
RELOAD=true

# ── CORS ─────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost

# ── PostgreSQL (OLTP) ────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aegisx
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=aegisx
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# ── TimescaleDB (Time-Series Events) ─────────────────────────────
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5434
TIMESCALEDB_USER=aegisx
TIMESCALEDB_PASSWORD=change-me-timescaledb-password
TIMESCALEDB_DB=aegisx_tsdb

# ── ClickHouse (Columnar Analytics) ──────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=aegisx
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
CLICKHOUSE_DB=aegisx_analytics

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── OpenSearch ───────────────────────────────────────────────────
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX_PREFIX=aegisx

# ── RabbitMQ ─────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ── Kafka (Event Streaming) ──────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EVENTS_RAW=events.raw
KAFKA_TOPIC_EVENTS_NORMALIZED=events.normalized
KAFKA_TOPIC_ALERTS_TRIGGERED=alerts.triggered
KAFKA_TOPIC_TELEMETRY_AGENT=telemetry.agent
KAFKA_RETENTION_MS=604800000
KAFKA_COMPRESSION_TYPE=snappy

# ── Schema Registry ──────────────────────────────────────────────
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_COMPATIBILITY=full_transitive

# ── MinIO (S3 Object Storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=aegisx
MINIO_SECRET_KEY=change-me-minio-secret-key
MINIO_BUCKET_EVIDENCE=aegisx-evidence
MINIO_BUCKET_ARTIFACTS=aegisx-artifacts
MINIO_SECURE=false

# ── Celery ───────────────────────────────────────────────────────
# Optional: override broker/backend if not using Redis
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET_KEY=generate-a-strong-random-jwt-secret-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_RESET_TOKEN_EXPIRE_HOURS=24

# ── Password Policy ──────────────────────────────────────────────
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGITS=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_LOCKOUT_ATTEMPTS=5
PASSWORD_LOCKOUT_MINUTES=15

# ── MFA ──────────────────────────────────────────────────────────
MFA_ENABLED=true
MFA_ISSUER=AEGISX

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_API=1000/minute

# ── File Upload ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=100
ALLOWED_UPLOAD_EXTENSIONS=csv,json,xml,pdf,xlsx,docx,txt,log,pcap,zip,tar,gz
UPLOAD_DIR=/app/uploads

# ── Email (SMTP) ─────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@aegisx.com
SMTP_TLS=true

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=90

# ── Tenants ──────────────────────────────────────────────────────
MAX_TENANTS=10000
TENANT_ISOLATION_MODE=row
DEFAULT_TENANT_QUOTA_ASSETS=1000
DEFAULT_TENANT_QUOTA_USERS=100
DEFAULT_TENANT_QUOTA_STORAGE_GB=500

# ── AI / ML (Optional) ───────────────────────────────────────────
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.3
OPENAI_API_KEY=
OPENAI_API_BASE=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# ── Threat Intelligence (Optional) ───────────────────────────────
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
MISP_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_API_KEY=

# ── Agent Registration ───────────────────────────────────────────
AGENT_REGISTRATION_KEY=change-me-agent-key
AGENT_HEARTBEAT_INTERVAL=60
AGENT_STALE_TIMEOUT=300

# ── Observability ────────────────────────────────────────────────
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
TRACING_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=14250
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1

# ── Kubernetes ───────────────────────────────────────────────────
KUBERNETES_ENABLED=false
KUBERNETES_NAMESPACE=aegisx

# ── Feature Flags ────────────────────────────────────────────────
FEATURE_SOAR=true
FEATURE_THREAT_INTEL=true
FEATURE_AI=true
FEATURE_COMPLIANCE=true
FEATURE_VULNERABILITY=true
FEATURE_ASSET_DISCOVERY=true
FEATURE_AGENT=true
FEATURE_AUDIT=true
FEATURE_GRAPHQL=true
FEATURE_KAFKA=false
FEATURE_TIMESCALEDB=false
FEATURE_CLICKHOUSE=false
FEATURE_MINIO=false
FEATURE_DEDUP_BLOOM=false

# ── License Key (Enterprise Edition) ──────────────────────────────
# Leave empty for Community Edition (free, 3 tenants, 50 endpoints)
# Set to activate Enterprise features (AI, SSO, unlimited, white-label)
# Generate: python backend/app/core/license_key.py "Customer" "email" --trial
LICENSE_KEY=
